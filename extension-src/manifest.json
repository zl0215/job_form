{
  "manifest_version": 3,
  "name": "校招表单助手",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "本地识别并填写校招网申表单：只填空白项、不覆盖已有内容、不提交；资料只保存在本机浏览器。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "校招表单助手（打开/关闭页面面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "pdf.worker.min.js", "cmaps/*", "standard_fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
